# Public application URL used for canonical links and secure form origins.
ORIGIN=http://localhost:3000

# PostgreSQL connection. Docker Compose supplies the service hostname in production.
DATABASE_URL=postgresql://wolves:change-me@localhost:5432/wolves
POSTGRES_DB=wolves
POSTGRES_USER=wolves
POSTGRES_PASSWORD=change-me

# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_DAYS=30

# Explicitly provided to `npm run db:seed`; never hard-coded in application code.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=jarl
ADMIN_PASSWORD=replace-with-a-strong-password

# Live status can be disabled locally with mock mode.
SERVER_STATUS_MODE=mock
SERVER_STATUS_CACHE_SECONDS=30
SERVER_STATUS_TIMEOUT_MS=3000
SERVER_STATUS_ALLOW_PRIVATE_HOSTS=false

# Uploaded CMS media is stored on a persistent volume.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# adapter-node proxy/runtime settings.
HOST=0.0.0.0
PORT=3000
BODY_SIZE_LIMIT=6M
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1